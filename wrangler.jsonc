{
  // Majestic Roobee — Cloudflare Worker (API + static assets)
  "name": "majestic",
  "main": "worker/index.js",
  "compatibility_date": "2026-01-01",
  // `dist/` is a build artifact (gitignored), so any deploy must build first or
  // the assets.directory below won't exist. This makes a bare `wrangler deploy`
  // self-contained. NOTE: Cloudflare Workers Builds (dashboard CI) does NOT
  // honour this block — see docs/BUILD-MAP.md §7 for its required setting.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Storefront and admin are separate SPA entry pages; unknown paths fall
    // back to the storefront shell.
    "not_found_handling": "single-page-application",
    // Every storefront address goes through the Worker first, so it can write
    // that page's title, description and link-preview tags into the HTML
    // (worker/seo.js) — link previews and most crawlers never run JavaScript.
    // The built bundles, the admin and the static images skip it and are
    // served straight from the asset store.
    "run_worker_first": ["/*", "!/assets/*", "!/admin/*", "!/logo.png", "!/logo-light.png", "!/founder.jpg", "!/og-image.jpg", "!/apple-touch-icon.png"]
  },
  "triggers": {
    // Drain the automation outbox and enqueue time-based automations.
    "crons": ["*/15 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "majestic-roobee",
      "database_id": "305e9633-d97a-462b-8f73-91c42d1baf14",
      "migrations_dir": "migrations"
    }
  ],
  // Product imagery. Photos used to be BLOBs in D1, which inflated the
  // database, the nightly export and every restore. With this bucket bound,
  // new uploads go to R2 and images already in D1 keep serving from there —
  // worker/media.js reads either, and the stored /images/<id> URLs never
  // change. Unbind it and uploads simply fall back to D1 again.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "majesticroobee"
    }
  ]
  // Secrets (never committed): ADMIN_PASSWORD, ADMIN_TOKEN_SECRET, and
  // optionally PAYSTACK_SECRET_KEY. Local dev reads them from .dev.vars
  // (see .dev.vars.example); production is set via `wrangler secret put`
  // or the GitHub Actions deploy workflow.
}
