{
  // Majestic Roobee — Cloudflare Worker (API + static assets)
  "name": "majestic-roobee",
  "main": "worker/index.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Storefront and admin are separate SPA entry pages; unknown paths fall
    // back to the storefront shell.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "majestic-roobee",
      // Replace with the real database_id after `wrangler d1 create majestic-roobee`
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Development defaults — override in production:
    //   wrangler secret put ADMIN_PASSWORD
    //   wrangler secret put ADMIN_TOKEN_SECRET
    //   wrangler secret put PAYSTACK_SECRET_KEY   (enables live Paystack)
    "ADMIN_PASSWORD": "majestic-dev",
    "ADMIN_TOKEN_SECRET": "dev-only-change-me"
  }
}
