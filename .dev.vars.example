# Copy to .dev.vars for local development (never commit .dev.vars)
ADMIN_PASSWORD=majestic-dev
ADMIN_TOKEN_SECRET=dev-only-change-me

# Paystack. The secret key is the only credential needed — the integration uses
# the redirect flow, so no public key is involved and nothing reaches the
# browser. Use the sk_test_ key from Paystack → Settings → API Keys & Webhooks;
# with it, the test cards charge play money.
#
# Leave it unset and the card option is hidden at checkout entirely, so bank
# transfer and WhatsApp still work.
# PAYSTACK_SECRET_KEY=sk_test_xxx

# ERPRevolution (ERPrev). Issue these in the ERP at Administration › General
# Configuration › Manage API Access → Add Access API Token, attached to a
# dedicated read-only service user — a key's user cannot sign in interactively,
# so never attach one to a real person's account. The Authentication Secret is
# shown once, on that form, and never again.
#
# The secret is never sent anywhere: each request carries an HMAC-SHA256
# signature computed from it. Read access to products, stock and warehouses is
# all the pull needs; it never writes.
#
# Everything else about the link — which ERP, its address, the endpoint paths,
# the signing headers, and which of its locations is which shop — is configured
# in Admin → Integrations → Inventory & catalogue link, not here.
#
# Leave them unset and the connector reports itself as not connected and never
# calls out.
# ERP_API_KEY=k_1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d
# ERP_API_SECRET=s_shown_once_copy_it_now_0000000

# ERPRev → the shop, pushed (Admin → Integrations → "Instant updates from
# ERPRev"). The signing secret ERPRev shows when you create the webhook. Unset,
# every delivery to /api/erp/webhook is refused.
# ERP_WEBHOOK_SECRET=whsec_xxx

# Email, through Resend. RESEND_API_KEY is from resend.com → API Keys ("Sending
# access"); RESEND_FROM must be on a domain verified in Resend → Domains.
# Unset, emails are recorded as "queued" in Admin → Integrations instead.
# RESEND_API_KEY=re_xxx
# RESEND_FROM=Majestic Roobee <hello@majesticroobee.com>
# RESEND_REPLY_TO=care@majesticroobee.com
