# Copy to .dev.vars for local development (never commit .dev.vars)
ADMIN_PASSWORD=majestic-dev
ADMIN_TOKEN_SECRET=dev-only-change-me

# Paystack. The secret key is the only credential needed — the integration uses
# the redirect flow, so no public key is involved and nothing reaches the
# browser. Use the sk_test_ key from Paystack → Settings → API Keys & Webhooks;
# with it, the test cards charge play money.
#
# Leave it unset and the card option is hidden at checkout entirely, so bank
# transfer and WhatsApp still work.
# PAYSTACK_SECRET_KEY=sk_test_xxx

# ERPNext. The API key and secret of a dedicated integration user with read on
# Item, Item Price, Bin and Warehouse — ERPNext → User → that user → API Access
# → Generate Keys. Everything else about the link (the site address, which
# price list is the web price, which warehouse is which shop) is configured in
# Admin → Integrations → ERPNext, not here.
#
# Leave them unset and the connector reports itself as not connected and never
# calls out.
# ERP_API_KEY=xxxxxxxxxxxxxxx
# ERP_API_SECRET=xxxxxxxxxxxxxxx
