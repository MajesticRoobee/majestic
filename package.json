{
  "name": "majestic-roobee",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Majestic Roobee — perfume ecommerce platform (storefront + admin) on Cloudflare Workers + D1",
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "build": "vite build",
    "dev:worker": "npm run build && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply majestic-roobee --local",
    "db:migrate:remote": "wrangler d1 migrations apply majestic-roobee --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "vite": "^6.0.7",
    "wrangler": "^4.0.0"
  }
}
